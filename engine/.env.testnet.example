# Copy to engine/.env.testnet (gitignored) and fill in. Never commit the real file.
# One funded Monad-testnet wallet is enough: all other role wallets are derived from it
# and funded with `NETWORK=testnet node src/fund.ts --yes`.
MASTER_PK=0x...

# Optional overrides
# RPC_URL=https://testnet-rpc.monad.xyz      # a dedicated provider RPC avoids public rate limits
# WS_URL=wss://testnet-rpc.monad.xyz
# ADMIN_TOKEN=<random>                       # required to start the market scenario when hosted
